{
  "name": "jhunus-crafts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "vercel-build": "prisma generate && next build",
    "check": "npm run typecheck && npm run lint && npm run build",
    "vercel-build:with-db": "prisma generate && prisma migrate deploy && next build",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:orders": "tsx --conditions=react-server scripts/test-concurrency.ts",
    "test:shipping": "tsx --conditions=react-server scripts/test-shipping.ts",
    "test": "npm run test:orders && npm run test:shipping && npm run test:email && npm run test:accounts && npm run test:reviews",
    "test:email": "tsx --conditions=react-server scripts/test-email.ts",
    "test:accounts": "tsx --conditions=react-server scripts/test-accounts.ts",
    "test:reviews": "tsx --conditions=react-server scripts/test-reviews.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.42.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.26.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
