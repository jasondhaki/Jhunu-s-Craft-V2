# Jhunu's Crafts — environment template
#
# Copy to `.env` and fill in real values. NEVER commit `.env` (plan §13.7).
# If a real secret is ever committed, treat it as compromised and rotate it.

# --- Database -------------------------------------------------------------
# Postgres. Neon is the intended provider (CONTEXT.md D4, open question Q9).
# Neon gives two URLs: use the POOLED one for the app, the DIRECT one for
# migrations.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Site -----------------------------------------------------------------
# Canonical origin, no trailing slash. Used for canonical tags, sitemap,
# OG images, and email links (§17.1, §24).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth (§13.2) ---------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# --- Email (§10.2) --------------------------------------------------------
# Transactional provider — Resend or Postmark. Not self-hosted SMTP.
# Sender must be on your own domain with SPF/DKIM/DMARC configured, or
# confirmations land in spam and customers assume the site is a scam.
RESEND_API_KEY=""
EMAIL_FROM="orders@example.com"
EMAIL_REPLY_TO="hello@example.com"

# --- SMS (§10.3) ----------------------------------------------------------
# Local Bangladeshi SMS gateway. BD customers respond to SMS far more than
# email; order confirmation and shipped-with-tracking are the minimum.
SMS_API_KEY=""
SMS_SENDER_ID=""

# --- Payments (§8) --------------------------------------------------------
# Gateway is not chosen yet (CONTEXT.md Q7). Every provider sits behind our
# own PaymentProvider interface, so these are adapter-specific (§8.3).
# COD needs none of this and works without a gateway.
PAYMENT_PROVIDER="cod"

# SSLCommerz (sandbox first — never test payments in production, §12.4)
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_SANDBOX="true"

# Verifies inbound webhook signatures. An unsigned webhook is rejected (§8.3).
PAYMENT_WEBHOOK_SECRET=""

# --- Images (§12.2) -------------------------------------------------------
UPLOAD_PROVIDER="local"
CLOUDINARY_URL=""

# --- Analytics (§18) ------------------------------------------------------
# All of these load only AFTER consent for non-essential cookies (§13.8).
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""

# --- Monitoring (§24) -----------------------------------------------------
SENTRY_DSN=""
